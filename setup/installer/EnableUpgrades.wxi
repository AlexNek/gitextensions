<!--setup\installer\EnableUpgrades.wxi-->
<Include xmlns="http://wixtoolset.org/schemas/v4/wxs">

    <!-- Custom upgrade logic for version range control -->
    <Upgrade Id="$(var.UpgradeCode)">
        <UpgradeVersion Property="DOWNGRADEFOUND" Minimum="$(var.NumericVersion)" IncludeMinimum="no" OnlyDetect="yes" />
        <UpgradeVersion Property="UNSUPPORTEDOLDVERSION" Maximum="$(var.MinSupportedVersion)" IncludeMaximum="no" OnlyDetect="yes" />
        <UpgradeVersion Minimum="0.0.0" Maximum="$(var.NumericVersion)" Property="PREVIOUSVERSIONSINSTALLED" IncludeMaximum="no" MigrateFeatures="yes" />
    </Upgrade>

    <!-- Block downgrades and unsupported old versions -->
    <Launch
      Condition="NOT DOWNGRADEFOUND AND NOT UNSUPPORTEDOLDVERSION"
      Message="The installed version is not upgradeable to $(var.Version).&#xD;&#xA;Uninstall the previous version first.&#xD;&#xA;&#xD;&#xA;Setup will now exit."
  />

    <!-- Use MajorUpgrade for standard upgrade flow, but disable downgrade error since we handle it via Launch -->
    <MajorUpgrade
      Schedule="afterInstallInitialize"
      AllowSameVersionUpgrades="yes"
      DowngradeErrorMessage="!(loc.DowngradeError)" />

    <!-- Define custom properties used in UI -->
    <!-- Upgrading = true if this is an upgrade (not repair, not uninstall) -->
    <SetProperty Id="Upgrading" Value="1" After="FindRelatedProducts"
                 Condition="PREVIOUSVERSIONSINSTALLED AND NOT Installed" />

    <!-- Optional: Uninstalling, Maintenance, etc. -->
    <SetProperty Id="Uninstalling" Value="1" After="FindRelatedProducts"
                 Condition="Installed AND (REMOVE=&quot;ALL&quot;) AND NOT PREVIOUSVERSIONSINSTALLED" />

    <SetProperty Id="Maintenance" Value="1" After="FindRelatedProducts"
                 Condition="Installed AND NOT REMOVE AND NOT PREVIOUSVERSIONSINSTALLED" />

</Include>