<Project Sdk="WixToolset.Sdk/6.0.2">

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x86</Platform>
    <Version Condition=" '$(Version)' == '' ">0.00</Version>
    <NumericVersion Condition=" '$(NumericVersion)' == '' ">$(Version)</NumericVersion>
    <OutputName>GitExtensions</OutputName>
    <OutputType>Package</OutputType>
    <DefineSolutionProperties>false</DefineSolutionProperties>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\</IntermediateOutputPath>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <SuppressIces>ICE61;ICE80;ICE91;ICE38</SuppressIces>
    <SuppressValidation>true</SuppressValidation>
    <RunWixToolsOutOfProc>true</RunWixToolsOutOfProc>
    <AccelerateBuildsInVisualStudio>false</AccelerateBuildsInVisualStudio>

    <!-- Compute PluginManagerSourceDir similar to original -->
    <ArtifactsBinPath Condition=" '$(ArtifactsBinPath)' == '' ">$(MSBuildProjectDirectory)\..\artifacts\bin</ArtifactsBinPath>
    <ArtifactsPublishPath Condition=" '$(ArtifactsPublishPath)' == '' ">$(MSBuildProjectDirectory)\..\publish</ArtifactsPublishPath>
    <PluginManagerSourceDir>$([MSBuild]::NormalizeDirectory('$(ArtifactsBinPath)', '..', 'publish'))</PluginManagerSourceDir>
    <PluginManagerCommand>powershell.exe -ExecutionPolicy Bypass -File "$(MSBuildProjectDirectory)\..\..\eng\Download-PluginManager.ps1" -ExtractRootPath "$(PluginManagerSourceDir)\GitExtensions.PluginManager"</PluginManagerCommand>
    <DefineConstants>Version=$(Version);NumericVersion=$(Version);ArtifactsBinPath=$(ArtifactsBinPath);ArtifactsPublishPath=$(ArtifactsPublishPath);PluginManagerSourceDir=$(PluginManagerSourceDir)\GitExtensions.PluginManager\Output</DefineConstants>
    <DefineConstants Condition=" '$(Configuration)' == 'Debug' ">Debug;$(DefineConstants)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Source files -->
    <Compile Include="Product.wxs" />
    <Compile Include="UI\*.wxs" />
  </ItemGroup>

  <ItemGroup>
    <!-- WiX Extensions via PackageReference (recommended in WiX 4) -->
    <!-- Note: WixVSExtension is deprecated in WiX 4 and not needed unless using VS-specific features -->
    <!-- <PackageReference Include="WixToolset.VisualStudio.wixext" Version="6.0.2" /> -->
    <PackageReference Include="WixToolset.NetFx.wixext" />
    <PackageReference Include="WixToolset.UI.wixext"  />
    <PackageReference Include="WixToolset.Util.wixext"  />

  </ItemGroup>

  <!-- Custom target to download plugin manager -->
  <Target Name="DownloadPluginManager" BeforeTargets="BeforeBuild">
    <Exec
      Condition="!Exists('$(PluginManagerSourceDir)\GitExtensions.PluginManager')"
      Command="$(PluginManagerCommand)" />
  </Target>

</Project>